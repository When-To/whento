{
  // Solution file. It holds no sources of its own: every TypeScript file in this
  // package belongs to exactly one of the referenced projects, so `vue-tsc --build`
  // type-checks all of them and nothing can silently sit outside the check.
  //
  //   tsconfig.app.json   src/ and dev/          — browser, DOM libs, path alias
  //   tsconfig.node.json  the build tooling      — vite/vitest/playwright configs
  //   tsconfig.e2e.json   e2e/ and e2e-backend/  — Playwright specs and fixtures
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.e2e.json" }
  ]
}
