{
  "name": "whento-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "VITE_BUILD_TYPE=cloud vite",
    "dev:selfhosted": "VITE_BUILD_TYPE=selfhosted vite",
    "build": "vue-tsc && VITE_BUILD_TYPE=selfhosted vite build",
    "build:cloud": "vue-tsc && VITE_BUILD_TYPE=cloud vite build",
    "build:selfhosted": "vue-tsc && VITE_BUILD_TYPE=selfhosted vite build",
    "build:docker": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,json}\""
  },
  "dependencies": {
    "axios": "^1.18.1",
    "countries-and-timezones": "^3.9.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.32.0",
    "i18n-iso-countries": "^7.14.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.7"
  }
}
