{
  "name": "whento-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "VITE_BUILD_TYPE=cloud vite",
    "dev:selfhosted": "VITE_BUILD_TYPE=selfhosted vite",
    "build": "npm run type-check && VITE_BUILD_TYPE=selfhosted vite build",
    "build:cloud": "npm run type-check && VITE_BUILD_TYPE=cloud vite build",
    "build:selfhosted": "npm run type-check && VITE_BUILD_TYPE=selfhosted vite build",
    "build:docker": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:suppress": "eslint . --suppress-all",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:backend": "playwright test --config playwright.backend.config.ts",
    "type-check": "vue-tsc --build --force",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "format": "prettier --write \"{src,dev,e2e,e2e-backend,scripts}/**/*.{vue,ts,js,mjs,css,json}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"{src,dev,e2e,e2e-backend,scripts}/**/*.{vue,ts,js,mjs,css,json}\" \"*.{ts,js,json}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "countries-and-timezones": "^3.10.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.37.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "swagger2openapi": "^7.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
