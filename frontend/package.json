{
  "name": "whento-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "VITE_BUILD_TYPE=cloud vite",
    "dev:selfhosted": "VITE_BUILD_TYPE=selfhosted vite",
    "build": "vue-tsc && VITE_BUILD_TYPE=selfhosted vite build",
    "build:cloud": "vue-tsc && VITE_BUILD_TYPE=cloud vite build",
    "build:selfhosted": "vue-tsc && VITE_BUILD_TYPE=selfhosted vite build",
    "build:docker": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,json}\""
  },
  "dependencies": {
    "axios": "^1.13.4",
    "countries-and-timezones": "^3.8.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.26.8",
    "i18n-iso-countries": "^7.14.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.1",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vueuse/core": "^14.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4"
  }
}
