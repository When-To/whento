# WhenTo Self-hosted - Environment variables for self-hosted version
# Copyright (C) 2025 WhenTo Contributors

# Build type (do not change)
BUILD_TYPE=selfhosted

# Database
DATABASE_URL=postgres://whento:password@postgres:5432/whento?sslmode=disable

# Redis (for caching and rate limiting)
REDIS_URL=redis://:password@redis:6379

# JWT Configuration
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Application
APP_URL=http://localhost:8080
ALLOWED_REGISTER=true
ALLOWED_EMAILS=

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Security
BCRYPT_COST=12
# Comma-separated list of allowed CORS origins (default: APP_URL)
CORS_ORIGINS=http://localhost:8080
# Comma-separated list of trusted reverse proxy IPs or CIDR ranges (leave empty if no proxy)
# Examples: 10.0.0.1, 172.17.0.0/16, 2001:db8::/32
TRUSTED_PROXIES=
