# ==============================================================================
# WhenTo - Environment variables (development / cloud compose stack)
# Copy this file to .env and adapt the values before first launch.
#
# Every variable below is validated at startup. A variable that is absent takes
# its documented default; a variable that is present but malformed — a typo in a
# number, a duration or a true/false — stops the process with a message naming
# it, instead of silently reverting to the default.
#
# Booleans are read generously: true/false, 1/0, t/f, yes/no, y/n and on/off are
# all accepted, in any case. Anything else (RATE_LIMIT_ENABLED=maybe) is a typo
# and stops the process.
#
# Secrets can be read from a file instead of the environment, which is how
# Docker secrets and Kubernetes mount them: append _FILE to the variable name
# and give it a path. Supported for DATABASE_URL, DB_PASSWORD, REDIS_URL,
# REDIS_PASSWORD, SMTP_PASSWORD and RATE_LIMIT_KEY_SALT.
#
#   SMTP_PASSWORD_FILE=/run/secrets/smtp_password
#
# Setting both a variable and its _FILE companion is an error, and so is a
# _FILE pointing at a file that cannot be read or is empty. Surrounding
# whitespace in the file is trimmed, so `echo secret > file` works.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# APP_PORT      = host port published by docker compose (mapping APP_PORT:8080).
# PORT (in app) = binding port inside the container — hardcoded to 8080 in
#                 docker-compose.yml, also used by `make dev-backend` (5173).
APP_PORT=8080
APP_ENV=production
APP_URL=http://localhost:8080
LOG_LEVEL=debug

# Development note: when running the Vite dev server for the frontend,
# set PORT=5173 for the backend. The frontend then runs on :8080 and
# proxies /api requests to the backend on :5173.

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
#
# Two ways to configure the database, depending on how you deploy WhenTo:
#
# A) docker-compose (the docker-compose.yml shipped with this repo)
#    The DB_* variables below are REQUIRED. They are consumed both by the
#    postgres service (POSTGRES_USER/PASSWORD/DB) and by the app service,
#    which builds DATABASE_URL from them. A DATABASE_URL set here is IGNORED
#    by the compose file in this mode.
#
# B) Standalone / binary deployment (no compose, or your own compose)
#    Set DATABASE_URL directly (preferred). The DB_* variables are then only
#    used as a fallback if DATABASE_URL is not set.
# ------------------------------------------------------------------------------
# Required for docker-compose deployments:
DB_NAME=whento
DB_USER=whento
DB_PASSWORD=your_secure_password_here
# Used only in standalone / binary deployments as fallback when DATABASE_URL
# is unset (the official compose hardcodes host=postgres, port=5432,
# sslmode=disable and does not expose postgres on the host):
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=disable

# For standalone / binary deployments only (ignored by the official compose):
# DATABASE_URL=postgres://db_user:your_secure_password@localhost:5432/whento?sslmode=disable

# Connection pool. The defaults below suit a single instance against a stock
# PostgreSQL, whose max_connections is 100. Running several replicas against one
# database means dividing DB_MAX_CONNS by the replica count, or the Nth replica
# fails to connect at the worst possible moment.
# DB_MIN_CONNS must not exceed DB_MAX_CONNS, and both durations must be positive.
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m

# ------------------------------------------------------------------------------
# Redis
#
# Same logic as the database:
# A) docker-compose: REDIS_PASSWORD is REQUIRED (used by the redis service via
#    --requirepass, and by the app to build REDIS_URL). A REDIS_URL set here is
#    IGNORED in this mode.
# B) Standalone / binary: set REDIS_URL directly (preferred); the REDIS_*
#    variables are only used as a fallback.
# ------------------------------------------------------------------------------
# Required for docker-compose deployments:
REDIS_PASSWORD=your_redis_password_here
# Used only in standalone / binary deployments as fallback when REDIS_URL is
# unset (the official compose hardcodes host=redis, port=6379 and does not
# expose redis on the host):
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_DB=0

# For standalone / binary deployments only (ignored by the official compose):
# REDIS_URL=redis://:your_redis_password@localhost:6379/0

# ------------------------------------------------------------------------------
# JWT - Keys are auto-generated on first container start
#
# The key pair MUST persist across restarts and container recreations: a new pair
# invalidates every access and refresh token, logging out every signed-in user.
# The official docker-compose.yml keeps it in the named volume `whento_keys`
# mounted on /app/keys (the paths below are the ones used outside Docker).
# Participant calendar links are unaffected — they authorise by the link itself.
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
# JWT_ISSUER=whento

# ------------------------------------------------------------------------------
# Registration & access control
# ------------------------------------------------------------------------------
# Allow new user registrations (after first admin user)
ALLOWED_REGISTER=true
# Comma-separated list of allowed email patterns (supports wildcards)
# Examples:
#   * = all emails allowed (default)
#   *@example.com = all emails from example.com domain
#   user@* = specific user from any domain
#   admin@example.com,*@company.org = specific email OR all from company.org
ALLOWED_EMAILS=*

# ------------------------------------------------------------------------------
# Email / SMTP (required for email verification and notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
# Sender address - must match the SMTP account
SMTP_FROM=contact@example.com
SMTP_FROM_NAME=WhenTo
# TLS is determined automatically by port:
#   port 465 -> implicit TLS
#   port 587 (or other) -> STARTTLS
# There is no separate TLS toggle variable.

# Email verification required before creating calendars.
# Turning this on without SMTP_HOST logs a warning at startup when
# APP_ENV=production and otherwise does nothing visible: no mail can leave the
# instance, so every new account stays unverified and unable to create a
# calendar. Either point SMTP_HOST at a mail server or leave this false. Note
# that the shipped docker-compose.yml defaults it to true.
EMAIL_VERIFICATION_ENABLED=false
# EMAIL_VERIFICATION_EXPIRY=24h

# Token expirations
# PASSWORD_RESET_EXPIRY=1h
# MAGIC_LINK_EXPIRY=1h

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Password hashing cost. Accepted range: 4-15, and at least 10 when
# APP_ENV=production — a cheaper hash is worth cracking offline the day a
# password table leaks. Above 15 every login costs about a second of CPU.
BCRYPT_COST=12
# Comma-separated list of allowed CORS origins (default: APP_URL).
# Each entry must be a bare origin: scheme://host[:port], with no trailing
# slash and no path — that is all a browser ever sends in an Origin header.
CORS_ORIGINS=http://localhost:8080
# Comma-separated list of trusted reverse proxy IPs or CIDR ranges (leave empty if no proxy)
# Only these IPs are allowed to set X-Forwarded-For / X-Real-IP headers, and
# this list is the only thing deciding whether that header is believed at all.
# Getting it wrong is not a small mistake: the header is then never believed and
# every client behind the proxy shares the proxy's rate-limit bucket, so "5
# logins per minute per IP" becomes 5 per minute for the whole instance.
#
# Prefer an IP address or a CIDR range: 10.0.0.1, 172.17.0.0/16, 2001:db8::/32.
# A hostname is also accepted — a compose service name such as `nginx` is what
# identifies the proxy everywhere else in your stack — and is resolved to its
# addresses at startup. That resolution happens ONCE: redeploying the proxy
# gives it a new address the application will not see, which puts you back in
# the shared-bucket case above, so a range covering the proxy is the safer
# value. A name that does not resolve stops the process rather than quietly
# matching nothing.
# See docs/reverse-proxy.md §1 for how to find the right value.
TRUSTED_PROXIES=
# Disable robots.txt (for private/non-public instances)
# DISABLE_ROBOTS=false

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# Salt used to derive rate limit bucket names. Buckets are stored hashed, so
# Redis never holds an IP address, a calendar token or a participant id.
# Leave empty for a single instance: one is then generated per process.
# Running several instances against the SAME Redis requires setting this to an
# identical secret everywhere — otherwise each instance keeps its own buckets
# and N instances grant N times the configured allowance.
# RATE_LIMIT_KEY_SALT=

# ------------------------------------------------------------------------------
# Metrics (Prometheus)
#
# Off by default: /metrics names every route and counts every error, which is
# not something to publish to the internet without deciding to.
# The endpoint always gets a listener of its own, never the application port, so
# publishing it is a deliberate port mapping. METRICS_PORT chooses that port;
# leaving it empty uses the built-in default (9090). It may not equal PORT.
# ------------------------------------------------------------------------------
# METRICS_ENABLED=false
# METRICS_PORT=9090

# ------------------------------------------------------------------------------
# Two-factor authentication (TOTP)
#
# TOTP_DIGITS accepts 6-8 and TOTP_PERIOD 15-300 seconds; the standard values
# are 6 and 30, and authenticator apps cannot display anything else.
# ------------------------------------------------------------------------------
# TOTP_ISSUER=WhenTo
# TOTP_DIGITS=6
# TOTP_PERIOD=30

# ------------------------------------------------------------------------------
# Docker build argument (not consumed at runtime)
# ------------------------------------------------------------------------------
VERSION=latest
